<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
	<schema id="org.gnome.shell.extensions.media-label"
		path="/org/gnome/shell/extensions/media-label/">

		<key name="album-radius" type="i">
			<default>8</default>
		</key>

		<key name="auto-color" type="b">
			<default>true</default>
		</key>

		<key name="color-intensity" type="i">
			<default>30</default>
		</key>

		<key name="panel-position" type="i">
			<default>1</default>
		</key>

		<key name="panel-index" type="i">
			<default>0</default>
		</key>

		<key name="button-width" type="i">
			<default>300</default>
		</key>

		<key name="padding-left" type="i">
			<default>8</default>
		</key>
		<key name="padding-right" type="i">
			<default>12</default>
		</key>

		<key name="display-mode" type="i">
			<default>2</default>
		</key>

		<key name="media-players" type="s">
			<default>"{}"</default>
		</key>

		<key name="seek-step" type="i">
			<default>5000000</default>
		</key>

		<key name="seek-timecode-duration" type="i">
			<default>1500</default>
		</key>

		<key name="preview-animation" type="s">
			<default>"Quad"</default>
		</key>

		<key name="preview-animation-custom" type="s">
			<default>"{}"</default>
		</key>

		<key name="preview-autoclose" type="b">
			<default>false</default>
		</key>

		<key name="preview-autoclose-delay" type="i">
			<default>5</default>
		</key>

		<key name="marquee-speed" type="i">
			<default>60</default>
		</key>

		<key name="marquee-delay-start" type="i">
			<default>2000</default>
		</key>

		<key name="marquee-delay-end" type="i">
			<default>2000</default>
		</key>

		<key name="title-cleanup-preset" type="s">
			<default>"off"</default>
		</key>

		<key name="title-cleanup-custom-words" type="s">
			<default>"[]"</default>
		</key>

	</schema>
</schemalist>